# Copy to .env for local use. Never commit the real .env — this repo is public.

# Postgres connection (matches docker-compose.yml defaults below)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gabriel
SPRING_DATASOURCE_USERNAME=gabriel
SPRING_DATASOURCE_PASSWORD=gabriel

# Gabriel's AI microservice. Not needed while AI_SERVICE_MOCK=true.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_MOCK=true

# Frontend origin allowed to call this API (Next.js dev server by default)
CORS_ALLOWED_ORIGINS=http://localhost:3000

PORT=8080
