# Copy this file to .env in the same folder and fill in real values.
# .env must NEVER be committed — it's covered by the root .gitignore.

# ---- Groq (free tier, ~1000 req/day, no credit card) ----
# Get a key at https://console.groq.com
# >>> THIS IS THE ONE YOU NEED TO FILL IN <<<
GROQ_API_KEY=

# openai/gpt-oss-20b and openai/gpt-oss-120b are the only models with strict
# (guaranteed-schema) JSON structured output on Groq as of 2026-07-16. Each has its own
# separate daily token quota. 120b is more reliable on edge-case/graphic content but has
# a smaller 200k tokens/day cap; 20b is the safer default to avoid burning it out.
GROQ_MODEL=openai/gpt-oss-20b

# ---- Service config ----
# Port the FastAPI app listens on (should match docker-compose's ai-service port mapping)
PORT=8000

ENV=development
