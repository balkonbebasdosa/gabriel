# Copy this file to .env in the same folder and fill in real values.
# .env must NEVER be committed — it's covered by the root .gitignore.

# ---- OpenRouter (pay-as-you-go, OpenAI-compatible gateway) ----
# Get a key at https://openrouter.ai
# >>> THIS IS THE ONE YOU NEED TO FILL IN <<<
OPENROUTER_API_KEY=

# openai/gpt-oss-20b routed through OpenRouter. require_parameters:true (set in
# llm_client.py) forces OpenRouter to only route to backend providers that honor
# strict JSON schema output — open-weight models like this one can be served by
# multiple different backends, not all of which guarantee schema compliance.
OPENROUTER_MODEL=openai/gpt-oss-20b

# ---- Service config ----
# Port the FastAPI app listens on (should match docker-compose's ai-service port mapping)
PORT=8000

ENV=development
